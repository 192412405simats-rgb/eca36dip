
clc;
clear;
close all;

% Read RGB image
RGB = imread('peppers.png');

R = RGB(:,:,1);
G = RGB(:,:,2);
B = RGB(:,:,3);
Z = zeros(size(R), 'uint8');

% (a) RGB components
figure('Name','RGB Colour Model');

subplot(2,4,1);
imshow(RGB);
title('Original Image');

subplot(2,4,2);
imshow(cat(3,R,Z,Z));
title('Red Component');

subplot(2,4,3);
imshow(cat(3,Z,G,Z));
title('Green Component');

subplot(2,4,4);
imshow(cat(3,Z,Z,B));
title('Blue Component');

subplot(2,4,6);
imshow(R);
title('Red Intensity');

subplot(2,4,7);
imshow(G);
title('Green Intensity');

subplot(2,4,8);
imshow(B);
title('Blue Intensity');

% (b) CMY colour model
CMY = imcomplement(RGB);

figure('Name','CMY Colour Model');

subplot(1,4,1);
imshow(CMY);
title('CMY Image');

subplot(1,4,2);
imshow(CMY(:,:,1));
title('Cyan');

subplot(1,4,3);
imshow(CMY(:,:,2));
title('Magenta');

subplot(1,4,4);
imshow(CMY(:,:,3));
title('Yellow');

% (c) HSV and YCbCr colour models
HSV = rgb2hsv(RGB);
YCC = rgb2ycbcr(RGB);

figure('Name','HSV and YCbCr Colour Models');

subplot(2,3,1);
imshow(HSV(:,:,1));
title('Hue');

subplot(2,3,2);
imshow(HSV(:,:,2));
title('Saturation');

subplot(2,3,3);
imshow(HSV(:,:,3));
title('Value');

subplot(2,3,4);
imshow(YCC(:,:,1));
title('Y Component');

subplot(2,3,5);
imshow(YCC(:,:,2));
title('Cb Component');

subplot(2,3,6);
imshow(YCC(:,:,3));
title('Cr Component');

% (d) Display pixel values
r = 200;
c = 300;

fprintf('RGB = [%d %d %d]\n', ...
    RGB(r,c,1), RGB(r,c,2), RGB(r,c,3));

fprintf('CMY = [%d %d %d]\n', ...
    CMY(r,c,1), CMY(r,c,2), CMY(r,c,3));

fprintf('HSV = [%.3f %.3f %.3f]\n', ...
    HSV(r,c,1), HSV(r,c,2), HSV(r,c,3));

fprintf('YCbCr = [%d %d %d]\n', ...
    YCC(r,c,1), YCC(r,c,2), YCC(r,c,3));

% (e) Enhance colour saturation
HSV2 = HSV;
HSV2(:,:,2) = min(1.5 * HSV(:,:,2), 1);

Enhanced = hsv2rgb(HSV2);

figure('Name','Colour Saturation Enhancement');

subplot(1,2,1);
imshow(RGB);
title('Original Image');

subplot(1,2,2);
imshow(Enhanced);
title('Enhanced Saturation');

% Display completion message
disp('All colour model conversions completed successfully.');
