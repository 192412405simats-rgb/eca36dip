
clc;
clear;
close all;

%% Read the Input Image

I = imread('cameraman.tif');

%% Part A: Bit-Plane Decomposition

% Display all 8 bit planes
figure('Name', 'Bit-Plane Decomposition');

for b = 1:8

    subplot(2, 4, b);

    imshow(logical(bitget(I, b)));

    title(sprintf('Bit Plane %d', b - 1));

end

%% Reconstruction Using Most Significant Bit Planes

% Reconstruct using the 4 most significant bit planes
R4 = bitand(I, uint8(240));

% Reconstruct using the 2 most significant bit planes
R2 = bitand(I, uint8(192));

% Display original and reconstructed images
figure('Name', 'Reconstruction from MSB Planes');

subplot(1, 3, 1);
imshow(I);
title('Original Image');

subplot(1, 3, 2);
imshow(R4);
title(sprintf('4 Planes (%.1f dB)', psnr(R4, I)));

subplot(1, 3, 3);
imshow(R2);
title(sprintf('2 Planes (%.1f dB)', psnr(R2, I)));

%% Part B: Lossless Predictive Coding

% Convert image to double precision
X = double(I);

% Initialize prediction error matrix
E = X;

% Calculate horizontal prediction errors
E(:, 2:end) = X(:, 2:end) - X(:, 1:end-1);

% Reconstruct the original image
Xr = cumsum(E, 2);

%% Calculate Image Entropy

% Calculate probability distribution of the original image
pI = imhist(I) / numel(I);

% Remove zero probabilities
pI = pI(pI > 0);

% Calculate prediction error histogram
pE = histcounts(E(:), -255.5:255.5);

% Normalize prediction error probabilities
pE = pE(pE > 0) / numel(E);

% Calculate entropy values
HI = -sum(pI .* log2(pI));
HE = -sum(pE .* log2(pE));

%% Display Entropy and Compression Results

fprintf('Entropy of image = %.4f bits/pixel\n', HI);

fprintf('Entropy of prediction error = %.4f bits/pixel\n', HE);

fprintf('Achievable CR (image) = %.3f\n', 8 / HI);

fprintf('Achievable CR (error) = %.3f\n', 8 / HE);

fprintf('Lossless reconstruction = %d\n', isequal(Xr, X));

%% Display Predictive Coding Results

figure('Name', 'Predictive Coding');

% Original image
subplot(1, 3, 1);
imshow(I);
title('Original Image');

% Prediction error image
subplot(1, 3, 2);
imshow(E, [-50 50]);
title('Prediction Error');

% Prediction error histogram
subplot(1, 3, 3);
histogram(E(:), -100:100);
title('Error Histogram');
xlabel('Prediction Error');
ylabel('Frequency');

%% Completion Message

disp('Bit-plane decomposition and predictive coding completed.');
