
clc;
clear;
close all;

%% Read the Input Images

cam = imread('cameraman.tif');
bag = imread('bag.png');

%% Prepare Texture Samples

% Extract image regions and generate a checkerboard pattern
P = {cam(1:64, 1:64), ...
     bag(1:64, 1:64), ...
     im2uint8(checkerboard(8))};

% Define texture sample names
names = {'Smooth (sky)', ...
         'Coarse (fabric)', ...
         'Regular (checkerboard)'};

%% Part A: Display Texture Samples

figure('Name', 'Texture Samples');

for k = 1:3

    subplot(1, 3, k);

    imshow(P{k});

    title(names{k});

end

%% Part B: Histogram-Based Statistical Descriptors

% Display table headings
fprintf('%-24s %7s %7s %7s %8s %7s %8s\n', ...
    'Region', 'Mean', 'StdDev', 'R', ...
    'Mu3', 'Unif', 'Entropy');

% Calculate statistical features for each texture
for k = 1:3

    % Convert image pixels to a vector
    z = double(P{k}(:));

    % Calculate mean and standard deviation
    m = mean(z);
    s = std(z);

    % Calculate smoothness
    R = 1 - 1 / (1 + s^2 / 255^2);

    % Calculate normalized third central moment
    mu3 = mean((z - m).^3) / 255^2;

    % Calculate normalized gray-level histogram
    p = imhist(P{k}) / numel(z);

    % Calculate histogram uniformity
    U = sum(p.^2);

    % Calculate image entropy
    e = entropy(P{k});

    % Display statistical results
    fprintf('%-24s %7.2f %7.2f %7.4f %8.3f %7.4f %8.3f\n', ...
        names{k}, m, s, R, mu3, U, e);

end

%% Part C: GLCM Texture Descriptors

% Define four spatial offsets
offsets = [ 0  1;
           -1  1;
           -1  0;
           -1 -1];

% Display GLCM table headings
fprintf('\n%-24s %9s %12s %8s %12s\n', ...
    'Region', 'Contrast', 'Correlation', ...
    'Energy', 'Homogeneity');

% Calculate GLCM features for each texture
for k = 1:3

    % Generate the gray-level co-occurrence matrix
    glcm = graycomatrix(P{k}, ...
        'Offset', offsets, ...
        'NumLevels', 8, ...
        'Symmetric', true);

    % Extract GLCM properties
    g = graycoprops(glcm, ...
        {'Contrast', 'Correlation', ...
         'Energy', 'Homogeneity'});

    % Calculate average feature values across offsets
    contrast = mean(g.Contrast);

    correlation = mean(g.Correlation, 'omitnan');

    energy = mean(g.Energy);

    homogeneity = mean(g.Homogeneity);

    % Display GLCM results
    fprintf('%-24s %9.3f %12.3f %8.3f %12.3f\n', ...
        names{k}, contrast, correlation, ...
        energy, homogeneity);

end

%% Part D: Local Texture Maps

figure('Name', 'Local Texture Measures');

% Display the original image
subplot(2, 2, 1);

imshow(bag);

title('Original Image');

% Calculate and display local range
subplot(2, 2, 2);

imshow(rangefilt(bag), []);

title('Local Range');

% Calculate and display local standard deviation
subplot(2, 2, 3);

imshow(stdfilt(bag), []);

title('Local Standard Deviation');

% Calculate and display local entropy
subplot(2, 2, 4);

imshow(entropyfilt(bag), []);

title('Local Entropy');

%% Completion Message

disp('Texture analysis completed.');
