
clc;
clear;
close all;

%% Part A: Periodic Noise Removal

% Read the original grayscale image
I = im2double(imread('cameraman.tif'));
[M, N] = size(I);

% Add periodic noise to the image
[x, y] = meshgrid(1:N, 1:M);
In = I + 0.2 * sin(2 * pi * (x/8 + y/8));

% Compute the 2-D Fourier Transform
F = fftshift(fft2(In));

% Create frequency coordinate grids
[u, v] = meshgrid(-N/2:N/2-1, -M/2:M/2-1);

% Define notch reject filter parameters
D0 = 10;
n = 4;
uk = N/8;
vk = M/8;

% Calculate distances from periodic noise frequencies
Dk1 = sqrt((u - uk).^2 + (v - vk).^2);
Dk2 = sqrt((u + uk).^2 + (v + vk).^2);

% Design the Notch Reject Filter
Hnr = (1 ./ (1 + (D0 ./ Dk1).^(2*n))) .* ...
      (1 ./ (1 + (D0 ./ Dk2).^(2*n)));

% Design the Band Reject Filter
D = sqrt(u.^2 + v.^2);
C0 = sqrt(uk^2 + vk^2);
W = 10;

Hbr = 1 - exp(-((D.^2 - C0^2) ./ (D * W)).^2);

% Apply the filters in the frequency domain
gNotch = real(ifft2(ifftshift(F .* Hnr)));
gBand = real(ifft2(ifftshift(F .* Hbr)));

% Display periodic noise removal results
figure('Name', 'Periodic Noise Removal');

subplot(2, 3, 1);
imshow(In, []);
title('Noisy Image');

subplot(2, 3, 2);
imshow(log(1 + abs(F)), []);
title('Frequency Spectrum');

subplot(2, 3, 3);
imshow(Hnr, []);
title('Notch Reject Filter');

subplot(2, 3, 4);
imshow(gNotch, []);
title('Notch Output');

subplot(2, 3, 5);
imshow(Hbr, []);
title('Band Reject Filter');

subplot(2, 3, 6);
imshow(gBand, []);
title('Band Reject Output');

%% Part B: Image Deblurring

% Create a motion blur point spread function
PSF = fspecial('motion', 21, 11);

% Apply motion blur to the original image
blur = imfilter(I, PSF, 'conv', 'circular');

% Add Gaussian noise to the blurred image
nvar = 1e-4;
gb = imnoise(blur, 'gaussian', 0, nvar);

% Perform Inverse Filtering
fInv = deconvwnr(gb, PSF, 0);

% Calculate the noise-to-signal ratio
NSR = nvar / var(I(:));

% Perform Wiener Filtering
fWnr = deconvwnr(gb, PSF, NSR);

% Perform Lucy-Richardson Deconvolution
fLR = deconvlucy(gb, PSF, 20);

% Display image deblurring results
figure('Name', 'Image Deblurring');

subplot(2, 3, 1);
imshow(I, []);
title('Original Image');

subplot(2, 3, 2);
imshow(blur, []);
title('Motion Blurred');

subplot(2, 3, 3);
imshow(gb, []);
title('Blurred + Noise');

subplot(2, 3, 4);
imshow(fInv, []);
title('Inverse Filtering');

subplot(2, 3, 5);
imshow(fWnr, []);
title('Wiener Filtering');

subplot(2, 3, 6);
imshow(fLR, []);
title('Lucy-Richardson');

%% Completion Message
disp('Periodic noise removal and image deblurring completed.');
