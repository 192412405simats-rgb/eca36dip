
clc;
clear;
close all;

%% Read the Input Image

I = imread('coins.png');

%% Part A: Correlation-Based Template Matching

% Display the image and select a coin template
figure('Name', 'Select Template');

imshow(I);
title('Select a coin template and double-click');

% Crop the selected template
T = imcrop;

% Calculate normalized cross-correlation
c = normxcorr2(T, I);

% Detect local maxima above the correlation threshold
pk = imregionalmax(c) & c > 0.75;

% Find peak coordinates
[yp, xp] = find(pk);

%% Display Template Matching Results

figure('Name', 'Template Matching');

% Display the selected template
subplot(1, 3, 1);
imshow(T);
title('Template');

% Display the correlation surface
subplot(1, 3, 2);
surf(c);
shading flat;
title('Normalized Cross-Correlation');

% Display detected matches
subplot(1, 3, 3);
imshow(I);
hold on;

title(sprintf('%d Matches', numel(yp)));

% Draw rectangles around detected matches
for k = 1:numel(yp)

    rectangle('Position', ...
        [xp(k) - size(T, 2) + 1, ...
         yp(k) - size(T, 1) + 1, ...
         size(T, 2), size(T, 1)], ...
        'EdgeColor', 'r', ...
        'LineWidth', 2);

end

%% Part B: Minimum-Distance Coin Classifier

% Convert the image into a binary image
bw = imfill(imbinarize(I), 'holes');

% Remove small connected objects
bw = bwareaopen(bw, 100);

% Extract region properties
s = regionprops(bw, I, ...
    'Area', 'MeanIntensity', 'Centroid');

% Construct feature vectors
X = [[s.Area]', [s.MeanIntensity]'];

% Normalize the feature vectors
Xn = (X - mean(X)) ./ std(X);

% Sort objects according to their area
[~, ord] = sort(X(:, 1));

% Calculate class centroids using the smallest and largest objects
m1 = mean(Xn(ord(1:2), :), 1);

m2 = mean(Xn(ord(end-1:end), :), 1);

% Calculate squared Euclidean distances
d1 = sum((Xn - m1).^2, 2);

d2 = sum((Xn - m2).^2, 2);

% Assign each coin to the nearest class centroid
cls = 1 + (d2 < d1);

% Define class names
label = {'Dime', 'Nickel'};

%% Display Classified Coins

figure('Name', 'Minimum-Distance Classifier');

imshow(I);
hold on;

% Label each detected coin
for k = 1:numel(s)

    text(s(k).Centroid(1), s(k).Centroid(2), ...
        label{cls(k)}, ...
        'Color', 'y', ...
        'FontWeight', 'bold', ...
        'HorizontalAlignment', 'center');

end

% Display the number of coins in each class
title(sprintf('Dime: %d, Nickel: %d', ...
    sum(cls == 1), sum(cls == 2)));

%% Display Feature Space

figure('Name', 'Feature Space');

% Plot the feature vectors for both classes
plot(X(cls == 1, 1), X(cls == 1, 2), 'bo', ...
     X(cls == 2, 1), X(cls == 2, 2), 'rs', ...
     'MarkerSize', 8, ...
     'LineWidth', 1.5);

% Label the axes
xlabel('Area (pixels)');
ylabel('Mean Intensity');

% Add legend and grid
legend(label);
grid on;

title('Coin Feature Vectors');

%% Completion Message

disp('Template matching and coin classification completed.');
