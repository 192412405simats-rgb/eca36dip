
clc;
clear;
close all;

% Read grayscale image
I = imread('pout.tif');
r = im2double(I);

% Part A: Gray-Level Transformations
s_neg = 1 - r;
s_log = mat2gray(log(1 + r));
s_g04 = r.^0.4;
s_g25 = r.^2.5;
s_cs = imadjust(I, stretchlim(I), []);

% Display transformed images
figure('Name','Gray-Level Transformations');

subplot(2,3,1);
imshow(r);
title('Original Image');

subplot(2,3,2);
imshow(s_neg);
title('Negative Image');

subplot(2,3,3);
imshow(s_log);
title('Log Transformation');

subplot(2,3,4);
imshow(s_g04);
title('Gamma 0.4');

subplot(2,3,5);
imshow(s_g25);
title('Gamma 2.5');

subplot(2,3,6);
imshow(s_cs);
title('Contrast Stretching');

% Part B: Transformation Curves
rr = linspace(0,1,256);

figure('Name','Transformation Curves');

plot(rr, 1-rr, ...
     rr, log(1+rr)/log(2), ...
     rr, rr.^0.4, ...
     rr, rr.^2.5, ...
     rr, rr, 'k--');

legend('Negative','Log','Gamma 0.4', ...
       'Gamma 2.5','Identity');

xlabel('Input Level');
ylabel('Output Level');
title('Gray-Level Transformation Curves');

grid on;
axis square;

% Part C: Colour Contrast Stretching
RGB = imread('peppers.png');

RGB_stretched = imadjust(RGB, [0.2 0.8], []);

figure('Name','Colour Contrast Stretching');

subplot(1,2,1);
imshow(RGB);
title('Original Colour Image');

subplot(1,2,2);
imshow(RGB_stretched);
title('Contrast Stretched Image');

% Part D: Intensity-Level Slicing
A = 0.40;
B = 0.70;

slice1 = r;
slice1(r >= A & r <= B) = 1;

slice2 = double(r >= A & r <= B);

figure('Name','Intensity-Level Slicing');

subplot(1,3,1);
imshow(r);
title('Original Image');

subplot(1,3,2);
imshow(slice1);
title('Band Highlighted');

subplot(1,3,3);
imshow(slice2);
title('Binary Slice');

% Completion Message
disp('Gray-level transformation and enhancement completed.');
