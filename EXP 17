
clc;
clear;
close all;

%% Read the Input Image

I = imread('cameraman.tif');

% Convert image to double and perform level shifting
X = double(I) - 128;

% Generate 8x8 DCT transformation matrix
T = dctmtx(8);

%% Part A: Block DCT

% Apply DCT to each 8x8 image block
C = blockproc(X, [8 8], ...
    @(b) T * b.data * T');

% Display original image and DCT coefficients
figure('Name', 'Block DCT');

subplot(1, 2, 1);
imshow(I);
title('Original Image');

subplot(1, 2, 2);
imshow(log(1 + abs(C)), []);
title('8x8 Block DCT');

%% Part B: JPEG-Style Quantisation

% Standard JPEG luminance quantisation matrix
Q50 = [16 11 10 16 24 40 51 61;
       12 12 14 19 26 58 60 55;
       14 13 16 24 40 57 69 56;
       14 17 22 29 51 87 80 62;
       18 22 37 56 68 109 103 77;
       24 35 55 64 81 104 113 92;
       49 64 78 87 103 121 120 101;
       72 92 95 98 112 100 103 99];

% Define JPEG quality levels
quality = [90 50 25 10];

% Create figure for reconstructed images
figure('Name', 'DCT Compression');

% Display table headings
fprintf('Quality  Non-zero Coeffs  Approx. CR  PSNR (dB)\n');

%% Process Each Quality Level

for k = 1:numel(quality)

    % Select quality factor
    q = quality(k);

    % Calculate quantisation scaling factor
    if q < 50
        s = 5000 / q;
    else
        s = 200 - 2 * q;
    end

    % Generate scaled quantisation matrix
    Q = max(floor((Q50 * s + 50) / 100), 1);

    % Apply DCT and quantisation to each block
    Cq = blockproc(X, [8 8], ...
        @(b) round((T * b.data * T') ./ Q));

    % Dequantise and apply inverse DCT
    Xr = blockproc(Cq, [8 8], ...
        @(b) T' * (b.data .* Q) * T);

    % Convert reconstructed image to uint8
    R = uint8(Xr + 128);

    % Calculate approximate compression ratio
    CR = numel(I) / nnz(Cq);

    % Calculate reconstruction quality
    P = psnr(R, I);

    % Display compression results
    fprintf('%5d %15d %11.2f %11.2f\n', ...
        q, nnz(Cq), CR, P);

    % Display reconstructed image
    subplot(2, 2, k);
    imshow(R);

    title(sprintf('Quality %d, PSNR = %.1f dB', q, P));

end

%% Part C: Standard JPEG Compression

% Compress image using MATLAB JPEG encoding
jpegQuality = [90 50 10];

for k = 1:numel(jpegQuality)

    % Select JPEG quality
    q = jpegQuality(k);

    % Generate output filename
    fname = sprintf('cameraman_q%d.jpg', q);

    % Save image using JPEG compression
    imwrite(I, fname, 'Quality', q);

    % Retrieve compressed file information
    d = dir(fname);

    % Display JPEG file size
    fprintf('JPEG Quality %d: File size = %d bytes\n', ...
        q, d.bytes);

end

%% Completion Message

disp('Block DCT and JPEG compression completed.');
