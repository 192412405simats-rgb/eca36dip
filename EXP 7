
clc;
clear;
close all;

% Read grayscale image
I = im2double(imread('cameraman.tif'));

% Part A: Smoothing Filters
h3 = fspecial('average', 3);
h9 = fspecial('average', 9);
hg = fspecial('gaussian', [9 9], 2);

S3 = imfilter(I, h3, 'replicate');
S9 = imfilter(I, h9, 'replicate');
Sg = imfilter(I, hg, 'replicate');

% Display smoothing results
figure('Name','Smoothing Filters');

subplot(2,2,1);
imshow(I);
title('Original Image');

subplot(2,2,2);
imshow(S3);
title('Average 3x3');

subplot(2,2,3);
imshow(S9);
title('Average 9x9');

subplot(2,2,4);
imshow(Sg);
title('Gaussian Filter');

% Part B: Sharpening Filters
hL = [0 1 0; 1 -4 1; 0 1 0];

L = imfilter(I, hL, 'replicate');

% Laplacian sharpening
G1 = I - L;

% Unsharp masking
mask = I - Sg;
G2 = I + mask;

% High-boost filtering
G3 = I + 3 * mask;

% Sobel gradient
hs = fspecial('sobel');

Gx = imfilter(I, hs', 'replicate');
Gy = imfilter(I, hs, 'replicate');

Gm = sqrt(Gx.^2 + Gy.^2);

% Display sharpening results
figure('Name','Sharpening Filters');

subplot(2,3,1);
imshow(I);
title('Original Image');

subplot(2,3,2);
imshow(L, []);
title('Laplacian');

subplot(2,3,3);
imshow(G1);
title('Laplacian Sharpening');

subplot(2,3,4);
imshow(G2);
title('Unsharp Masking');

subplot(2,3,5);
imshow(G3);
title('High-Boost Filtering');

subplot(2,3,6);
imshow(Gm, []);
title('Sobel Gradient');

% Completion message
disp('Smoothing and sharpening filter operations completed.');
