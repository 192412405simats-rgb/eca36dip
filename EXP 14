
clc;
clear;
close all;

%% Part A: Binary Dilation and Erosion

% Read the binary text image
BW = imread('text.png');

% Create a square structuring element
se = strel('square', 3);

% Perform dilation and erosion
BW_dilated = imdilate(BW, se);
BW_eroded = imerode(BW, se);

% Display the results
figure('Name', 'Dilation and Erosion');

subplot(1, 3, 1);
imshow(BW);
title('Original');

subplot(1, 3, 2);
imshow(BW_dilated);
title('Dilation');

subplot(1, 3, 3);
imshow(BW_eroded);
title('Erosion');

%% Part B: Opening and Closing

% Read the circles image
A = logical(imread('circles.png'));

% Add random binary noise
N = A;
idx = rand(size(A)) < 0.03;
N(idx) = ~N(idx);

% Create a disk-shaped structuring element
sd = strel('disk', 3);

% Perform opening and closing
O = imopen(N, sd);
OC = imclose(O, sd);

% Display the results
figure('Name', 'Opening and Closing');

subplot(2, 2, 1);
imshow(A);
title('Original');

subplot(2, 2, 2);
imshow(N);
title('Noisy Image');

subplot(2, 2, 3);
imshow(O);
title('Opening');

subplot(2, 2, 4);
imshow(OC);
title('Opening and Closing');

%% Part C: Boundary Extraction

% Create a square structuring element
se_boundary = strel('square', 3);

% Extract the boundary of the binary image
Bd = A & ~imerode(A, se_boundary);

% Display the extracted boundary
figure('Name', 'Boundary Extraction');

imshow(Bd);
title('Boundary of Circles');

%% Part D: Grayscale Morphology and Top-Hat Transform

% Read grayscale images
G = imread('cameraman.tif');
R = imread('rice.png');

% Create a disk-shaped structuring element
sg = strel('disk', 3);

% Perform grayscale morphological operations
G_dilated = imdilate(G, sg);
G_eroded = imerode(G, sg);
G_opened = imopen(G, sg);
G_closed = imclose(G, sg);

% Perform the Top-Hat transform
R_tophat = imtophat(R, strel('disk', 15));

% Display grayscale morphology results
figure('Name', 'Grayscale Morphology');

subplot(2, 3, 1);
imshow(G);
title('Original');

subplot(2, 3, 2);
imshow(G_dilated);
title('Dilation');

subplot(2, 3, 3);
imshow(G_eroded);
title('Erosion');

subplot(2, 3, 4);
imshow(G_opened);
title('Opening');

subplot(2, 3, 5);
imshow(G_closed);
title('Closing');

subplot(2, 3, 6);
imshow(R_tophat);
title('Top-Hat Transform');

%% Completion Message
disp('Morphological image processing completed.');
